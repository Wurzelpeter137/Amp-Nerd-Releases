---
/* Amp Nerd — Models (English). German variant: src/pages/de/models.astro. */
import Base from "../../layouts/Base.astro";
---

<Base locale="en" page="models">
  <section class="hero models-hero">
    <div class="wrap">
      <span class="kicker">Models</span>
      <h1>From Marshall to Mesa</h1>
      <figure class="models-figure">
        <img src="/img/models-list.png" alt="Models: selectable amplifier lists in the Amp Nerd app" width="542" height="280">
        <figcaption>The model selection dialog: family, model and variant.</figcaption>
      </figure>
      <p class="lead">
        Every amp as a complete circuit: preamp, tone control, phase inverter,
        power stage with output transformer, power supply and reactive speaker load –
        plus the original tube lineup. The <strong>info button</strong> in the plugin shows
        the history and original of each model and the output power computed from the
        current components.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="model-group" id="marshall-plexi">
        <h2>Marshall <span class="fam">Plexi&nbsp;·&nbsp;classic</span></h2>
        <div class="model-row">
          <div class="name">Micro Superlead</div>
          <div class="variant">1&nbsp;W</div>
          <div class="desc">Plexi preamp with a 12AU7 micro output stage (TheTubeRoaster, 2021).</div>
        </div>
        <div class="model-row">
          <div class="name">Super Lead</div>
          <div class="variant">1959 · 100&nbsp;W</div>
          <div class="desc">Solid-state rectifier, 4× EL34 in the output stage.</div>
        </div>
        <div class="model-row">
          <div class="name">Super Lead</div>
          <div class="variant">1987 · 50&nbsp;W</div>
          <div class="desc">Solid-state rectifier, 2× EL34 in the output stage.</div>
        </div>
        <div class="model-row">
          <div class="name">Super Lead</div>
          <div class="variant">1992 · Super Bass</div>
          <div class="desc">Late Plexi variant with a bass-oriented character.</div>
        </div>
      </div>

      <div class="model-group" id="marshall-jcm">
        <h2>Marshall <span class="fam">JCM series</span></h2>
        <div class="model-row">
          <div class="name">JTM45</div>
          <div class="variant">45&nbsp;W</div>
          <div class="desc">1965 – 2× KT66, fixed bias, GZ34 tube rectifier; the classic predecessor of the JCM line.</div>
        </div>
        <div class="model-row">
          <div class="name">JCM800 2203</div>
          <div class="variant">100&nbsp;W</div>
          <div class="desc">Cascade with “Cold Clipper”, master volume, High/Low inputs.</div>
        </div>
        <div class="model-row">
          <div class="name">JCM800 Micro (Rob&nbsp;Robinette)</div>
          <div class="variant">1&nbsp;W · 2&nbsp;W · 4&nbsp;W</div>
          <div class="desc">JCM800 preamp with a low-wattage output stage in three variants: 12AU7 1&nbsp;W, EF80 2&nbsp;W, Quad&nbsp;EF80 4&nbsp;W.</div>
        </div>
        <div class="model-row">
          <div class="name">Silver Jubilee 2555</div>
          <div class="variant">100&nbsp;W</div>
          <div class="desc">Lead / Rhythm / Rhythm Clip via relay, LED clipping, lead and output master volume.</div>
        </div>
        <div class="model-row">
          <div class="name">MK – MK5011 / JTK3</div>
          <div class="variant">MK5011 · JTK3</div>
          <div class="desc">Martin Kidd’s MK5011 (50&nbsp;W, EL34 or 6L6) and the little JTK3.</div>
        </div>
      </div>

      <div class="model-group" id="hiwatt">
        <h2>Hiwatt <span class="fam">British · warm</span></h2>
        <div class="model-row">
          <div class="name">DR103 Custom</div>
          <div class="variant">100&nbsp;W</div>
          <div class="desc">The “British Warmth” amp – as a complete circuit, from preamp to output stage.</div>
        </div>
      </div>

      <div class="model-group" id="fender">
        <h2>Fender <span class="fam">Tweed · Silverface · Brownface</span></h2>
        <div class="model-row">
          <div class="name">Tweed Champ</div>
          <div class="variant">SC1 · SE1 · 5F1</div>
          <div class="desc">Fender Tweed Champ – SC1 (1953), SE1 (1955), 5F1 (1958); single-ended with a 6V6.</div>
        </div>
        <div class="model-row">
          <div class="name">Tweed Princeton SC2</div>
          <div class="variant">1953 · Wide Panel</div>
          <div class="desc">6SC7 in two stages, Volume/Ton – a 6V6 single-ended stage with cathode bias.</div>
        </div>
        <div class="model-row">
          <div class="name">Tweed Deluxe</div>
          <div class="variant">Tweed 1955–1960</div>
          <div class="desc">The little Deluxe in Tweed form – rebuilt from input to output stage.</div>
        </div>
        <div class="model-row">
          <div class="name">Tweed Bassman</div>
          <div class="variant">5A6 · 5B6 · 5F6-A</div>
          <div class="desc">Fender Tweed Bassman – 5A6 (1952), 5B6 (1953), 5F6-A (1958); the big all-tube classic.</div>
        </div>
        <div class="model-row">
          <div class="name">Tweed Bandmaster 5E7</div>
          <div class="variant">1955 · Narrow Panel</div>
          <div class="desc">12AX7 input, Treble/Bass, Presence – 2× 6L6G with fixed bias.</div>
        </div>
        <div class="model-row">
          <div class="name">Silverface Deluxe Reverb</div>
          <div class="variant">A1172</div>
          <div class="desc">Fender Deluxe Reverb A1172 (Silverface) – own circuit.</div>
        </div>
        <div class="model-row">
          <div class="name">Brownface Twin</div>
          <div class="variant">6G8 · 1960</div>
          <div class="desc">Normal + Vibrato (Harmonic Vibrato), Treble/Bass per channel, Presence.</div>
        </div>
        <div class="model-row">
          <div class="name">Tweed Tremolux 5G9</div>
          <div class="variant">1957–1960</div>
          <div class="desc">Instrument/Microphone, Treble, Tremolo (Speed and Depth) – 2× 6V6.</div>
        </div>
      </div>

      <div class="model-group" id="dumble">
        <h2>Dumble</h2>
        <div class="model-row">
          <div class="name">Overdrive Special</div>
          <div class="variant">50&nbsp;W / 100&nbsp;W</div>
          <div class="desc">Dumble Overdrive Special – 1970s 50&nbsp;W / 100&nbsp;W (6L6), 1997 (EL34).</div>
        </div>
      </div>

      <div class="model-group" id="diezel">
        <h2>Diezel</h2>
        <div class="model-row">
          <div class="name">V4H</div>
          <div class="variant">100&nbsp;W</div>
          <div class="desc">The V4H with its well-known output stage – here in 100&nbsp;W.</div>
        </div>
      </div>

      <div class="model-group" id="mesa">
        <h2>Mesa / Boogie</h2>
        <div class="model-row">
          <div class="name">Dual Rectifier</div>
          <div class="variant">100&nbsp;W</div>
          <div class="desc">The “Recto” output stage – known for its compression and high, thick gain.</div>
        </div>
      </div>

      <div class="model-group" id="pedale">
        <h2>Pedals <span class="fam">own circuit, not a preset</span></h2>
        <div class="model-row">
          <div class="name">I – TS808</div>
          <div class="variant">Tube Screamer</div>
          <div class="desc">Input buffer, caps stage and tone/level stage – with its own circuit view.</div>
        </div>
        <div class="model-row">
          <div class="name">EQ pedal</div>
          <div class="variant">3-band</div>
          <div class="desc">Tone-control pedal with its own view – since version 1.54.0.</div>
        </div>
      </div>

      <p class="lead-in">
        All names only describe the circuits that were reproduced; they are trademarks of
        their respective owners (Marshall, Fender, Hiwatt, Dumble, Diezel, Mesa and
        others), and this project is not affiliated with them.
      </p>
    </div>
  </section>
</Base>
