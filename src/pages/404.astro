---
import Base from "../layouts/Base.astro";
---

<Base locale="de" page="notfound">
  <section class="hero">
    <div class="wrap">
      <span class="kicker">404</span>
      <h1>Seite nicht gefunden</h1>
      <p class="lead">
        Diese Adresse existiert nicht – die Seite wurde vielleicht verschoben.
        Über die Navigation oben kommst du zurück zum Start.
      </p>
      <div class="cta">
        <a class="btn btn-gold" href="/de/">Zur Startseite</a>
        <a class="btn btn-ghost" href="/en/">English version</a>
      </div>
    </div>
  </section>
</Base>
